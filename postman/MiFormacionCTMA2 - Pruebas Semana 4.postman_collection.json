              "    const respuesta = pm.response.json();\r",
              "\r",
              "    pm.expect(respuesta.title).to.eql(\"Estudiar Kotlin\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
