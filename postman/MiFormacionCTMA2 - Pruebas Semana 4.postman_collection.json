  "item": [
    {
      "name": "01 - Consultar actividad existente",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code es 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"El ID corresponde a la actividad solicitada\", function () {\r",
              "    const respuesta = pm.response.json();\r",
              "    const activityId = parseInt(pm.environment.get(\"activityId\"));\r",
              "\r",
              "    pm.expect(respuesta.id).to.eql(activityId);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts/{{activityId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "{{activityId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02 - Crear actividad válida",
